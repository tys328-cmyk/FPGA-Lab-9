module ram (
    input wire clk,
    input wire we,
    input wire [2:0] addr,
    input wire [7:0] data_in,
    output wire [7:0] data_out
);

    reg [7:0] memory [0:7];

    // Load initial RAM values from text file
    initial begin
        $readmemh("ram_data.mem", memory);
    end

    // Write data on rising clock edge
    always @(posedge clk) begin
        if (we)
            memory[addr] <= data_in;
    end

    // Read data from selected address
    assign data_out = memory[addr];

endmodule


