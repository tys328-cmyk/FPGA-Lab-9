module tb_ram;

reg clk;
    reg we;
    reg [2:0] addr;
    reg [7:0] data_in;
    wire [7:0] data_out;

ram uut (
        .clk(clk),
        .we(we),
        .addr(addr),
        .data_in(data_in),
        .data_out(data_out)
    );

// Clock generation
    always #5 clk = ~clk;

initial begin
        clk = 0;
        we = 0;
        addr = 0;
        data_in = 0;

// Read initial memory values
        #10;
        addr = 0;
        #10;
        addr = 1;
        #10;
        addr = 2;
        #10;
        addr = 3;

// Write new values
        #10;
        we = 1;
        addr = 0;
        data_in = 8'hAA;
        #10;
        addr = 1;
        data_in = 8'h55;
        #10;
        addr = 2;
        data_in = 8'hF0;
        #10;

// Read back written values
        we = 0;
        addr = 0;
        #10;
        addr = 1;
        #10;
        addr = 2;
        #10;

// Save RAM contents to text file
        $writememh("ram_output.mem", uut.memory);

$finish;
    end

endmodule


