module rom (
    input wire [2:0] addr,
    output wire [3:0] data_out
);

    reg [3:0] memory [0:7];

    // Load ROM contents from text file
    initial begin
        $readmemh("rom_data.mem", memory);
    end

    // Read selected ROM address
    assign data_out = memory[addr];

endmodule


